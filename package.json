{
  "name": "lop-sach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:text && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:text": "node scripts/check-repository-text.mjs",
    "dev": "pnpm --parallel --filter @lop-sach/api --filter @lop-sach/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm test:proxy && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @lop-sach/web test:e2e",
    "test:proxy": "vitest run api/proxy-core.test.ts",
    "test:topology": "pnpm --filter @lop-sach/web test:topology",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.vercel.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "esbuild", "mongodb-memory-server"]
  }
}
