{
  "name": "@lop-sach/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/cli/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "owner": "tsx src/cli/owner.ts",
    "start": "node dist/server.js",
    "test": "pnpm --filter @lop-sach/contracts build && pnpm --filter @lop-sach/scheduler build && vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lop-sach/contracts": "workspace:*",
    "@lop-sach/scheduler": "workspace:*",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "mongodb": "6.18.0",
    "mongoose": "8.18.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.2.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5"
  }
}
