[Unit]
Description=Lop Sach API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lop-sach
Group=lop-sach
WorkingDirectory=/opt/lop-sach/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/lop-sach/api.env
ExecStart=/usr/bin/node --max-old-space-size=384 apps/api/dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
